---
import { getImage } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BoutonWhatsApp from '../components/BoutonWhatsApp.astro';
import BlocCTA from '../components/BlocCTA.astro';
import logoDisque from '../assets/images/logo-disque.jpg';
import partageAccueil from '../assets/images/partage-accueil.jpg';

interface Props {
  /** Balise <title>, rédigée à la main et unique par page. */
  titre: string;
  /** Meta description, unique par page (≈ 150 caractères). */
  description: string;
  /** Nom lisible de la page, repris dans le message WhatsApp pré-rempli. */
  page: string;
  /** Image de partage (1200 × 630) ; par défaut l'enseigne du siège. URL distante acceptée (Supabase). */
  imagePartage?: ImageMetadata | string;
  /** Type Open Graph : « website » ou « article ». */
  typeOG?: 'website' | 'article';
  /** Exclut la page des moteurs de recherche (ex. /admin). */
  noindex?: boolean;
  /** Affiche le bloc d'appel à l'action commun en fin de page. */
  blocCTA?: boolean;
  /** Lien du bouton devis du bloc d'appel à l'action. */
  lienDevis?: string;
}

const {
  titre,
  description,
  page,
  imagePartage = partageAccueil,
  typeOG = 'website',
  noindex = false,
  blocCTA = true,
  lienDevis,
} = Astro.props;

const urlCanonique = new URL(Astro.url.pathname, Astro.site);

const [favicon, iconeApple, imageOG] = await Promise.all([
  getImage({ src: logoDisque, width: 48, height: 48, format: 'png' }),
  getImage({ src: logoDisque, width: 180, height: 180, format: 'png' }),
  getImage({ src: imagePartage, width: 1200, height: 630, fit: 'cover', format: 'jpg' }),
]);
const urlImageOG = new URL(imageOG.src, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={urlCanonique} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0A3D1F" />

    <link rel="icon" type="image/png" sizes="48x48" href={favicon.src} />
    <link rel="apple-touch-icon" href={iconeApple.src} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Partage (WhatsApp, Facebook) -->
    <meta property="og:type" content={typeOG} />
    <meta property="og:site_name" content="MADAL GROUP" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urlCanonique} />
    <meta property="og:image" content={urlImageOG} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="head" />
  </head>
  <body>
    <a class="lien-evitement" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu" tabindex="-1" data-inerte-menu>
      <slot />
      {blocCTA && <BlocCTA lienDevis={lienDevis} />}
    </main>
    <Footer />
    <BoutonWhatsApp page={page} />
    <script>
      import '../scripts/animations';
    </script>
  </body>
</html>
