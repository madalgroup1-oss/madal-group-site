---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CartePole from '../components/CartePole.astro';
import Icone from '../components/Icone.astro';
import Argument from '../components/Argument.astro';
import Synergie from '../components/Synergie.astro';
import EtapeMethode from '../components/EtapeMethode.astro';
import CarteSolution from '../components/CarteSolution.astro';
import CarteArticle from '../components/CarteArticle.astro';
import facade from '../assets/images/facade.jpg';
import equipe from '../assets/images/equipe.jpg';
import logoDisque from '../assets/images/logo-disque.jpg';
import { ACCROCHE } from '../lib/coordonnees';
import { jsonLd, organisation } from '../lib/seo';
import { ARGUMENTS, INTRODUCTION, METHODE, POLES_DETAILS } from '../data/groupe';
// Provisoire (phase 1) : remplacé par Supabase en phase 2
import { ARTICLES_PROVISOIRES, SOLUTIONS_PROVISOIRES } from '../data/provisoire';

const logoJsonLd = await getImage({ src: logoDisque, width: 320, height: 320, format: 'png' });
const donneesOrganisation = organisation(new URL(logoJsonLd.src, Astro.site).href);
---

<Base
  titre="MADAL GROUP — Consulting, Distribution et Technologie à Abidjan"
  description="MADAL GROUP SARL, groupe ivoirien basé à Abidjan : Madal Consulting, Madal Distribution et Madal Technologie. Un groupe, trois expertises, une même ambition."
  page="Accueil"
>
  <script type="application/ld+json" slot="head" set:html={jsonLd(donneesOrganisation)} />

  <!-- 1. Hero -->
  <section class="hero fond-fonce" aria-labelledby="hero-titre">
    <div class="hero__decor" aria-hidden="true"></div>
    <div class="conteneur hero__grille">
      <div class="hero__texte">
        <p class="etiquette">MADAL GROUP SARL · Abidjan</p>
        <h1 id="hero-titre">
          <span>Structurer.</span>{' '}<span>Distribuer.</span>{' '}<span>Innover.</span>
        </h1>
        <p class="hero__accroche">{ACCROCHE}</p>
        <p class="hero__introduction">{INTRODUCTION}</p>
        <div class="groupe-boutons hero__boutons">
          <a class="bouton" href="/le-groupe">Découvrir MADAL GROUP</a>
          <a class="bouton bouton--contour" href="/contact">Nous contacter</a>
        </div>
      </div>
      <div class="hero__visuel">
        <span class="hero__cadre" aria-hidden="true"></span>
        <Image
          src={facade}
          alt="Façade du siège de MADAL GROUP"
          widths={[360, 560, 720, 1120, 1240]}
          sizes="(min-width: 1200px) 560px, (min-width: 1000px) 46vw, calc(100vw - 48px)"
          loading="eager"
          fetchpriority="high"
          class="photo"
        />
      </div>
    </div>
  </section>

  <!-- 2. Les trois expertises -->
  <section class="section" id="expertises" aria-labelledby="expertises-titre">
    <div class="conteneur section__contenu">
      <div class="entete-section" data-apparition>
        <p class="etiquette">Nos expertises</p>
        <h2 id="expertises-titre">Trois pôles complémentaires</h2>
        <p>
          Chaque pôle a sa page, son équipe et sa demande de devis. Choisissez celui qui
          correspond à votre besoin.
        </p>
      </div>
      <ul class="grille" data-apparition-groupe>
        {
          POLES_DETAILS.map((pole) => (
            <li>
              <CartePole pole={pole} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 3. Pourquoi MADAL GROUP -->
  <section class="section section--grise" aria-labelledby="pourquoi-titre">
    <div class="conteneur section__contenu">
      <div class="entete-section" data-apparition>
        <p class="etiquette">Pourquoi MADAL GROUP</p>
        <h2 id="pourquoi-titre">Plus qu'une entreprise, une référence</h2>
      </div>
      <div class="pourquoi">
        <div class="pourquoi__visuel" data-apparition="image">
          <Image
            src={equipe}
            alt="L'équipe MADAL GROUP au travail"
            widths={[360, 560, 720, 1080, 1400]}
            sizes="(min-width: 1000px) 460px, calc(100vw - 48px)"
            class="photo"
          />
        </div>
        <div class="pourquoi__arguments" data-apparition-groupe>
          {ARGUMENTS.map((argument) => <Argument titre={argument.titre} texte={argument.texte} />)}
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Synergie -->
  <section class="section fond-fonce" aria-labelledby="synergie-titre">
    <div class="conteneur section__contenu">
      <div class="entete-section" data-apparition>
        <p class="etiquette">La synergie du groupe</p>
        <h2 id="synergie-titre">Un seul interlocuteur, trois réponses</h2>
      </div>
      <Synergie />
    </div>
  </section>

  <!-- 5. Notre méthode -->
  <section class="section" aria-labelledby="methode-titre">
    <div class="conteneur section__contenu">
      <div class="entete-section" data-apparition>
        <p class="etiquette">Notre méthode</p>
        <h2 id="methode-titre">Écouter, analyser, concevoir, accompagner</h2>
      </div>
      <ol class="grille grille--etroite" data-apparition-groupe>
        {
          METHODE.map((etape, index) => (
            <EtapeMethode numero={index + 1} titre={etape.titre} texte={etape.texte} />
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 6. Nos solutions -->
  <section class="section section--grise" aria-labelledby="solutions-titre">
    <div class="conteneur section__contenu">
      <div class="entete-ligne">
        <div class="entete-section" data-apparition>
          <p class="etiquette">Nos solutions</p>
          <h2 id="solutions-titre">Ce que nous avons déjà construit</h2>
        </div>
        <a class="lien-fleche" href="/solutions">
          Toutes les solutions
          <Icone nom="fleche" taille={18} />
        </a>
      </div>
      <ul class="grille grille--large" data-apparition-groupe>
        {
          SOLUTIONS_PROVISOIRES.map((solution) => (
            <li>
              <CarteSolution solution={solution} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 7. Le Mag MADAL -->
  <section class="section" aria-labelledby="mag-titre">
    <div class="conteneur section__contenu">
      <div class="entete-ligne">
        <div class="entete-section" data-apparition>
          <p class="etiquette">Le Mag MADAL</p>
          <h2 id="mag-titre">Actualités et conseils</h2>
        </div>
        <a class="lien-fleche" href="/mag">
          Tous les articles
          <Icone nom="fleche" taille={18} />
        </a>
      </div>
      <ul class="grille" data-apparition-groupe>
        {
          ARTICLES_PROVISOIRES.slice(0, 3).map((article) => (
            <li>
              <CarteArticle article={article} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 8. Appel à l'action : bloc commun ajouté par le layout -->
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  /* Décor : halo vert qui dérive lentement et trame de points estompée */
  .hero__decor {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .hero__decor::before {
    content: '';
    position: absolute;
    top: -30%;
    right: -20%;
    width: 80%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--vert-accent) 30%, transparent),
      transparent
    );
  }

  .hero__decor::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--sur-fonce-filet) 1.2px, transparent 1.2px);
    background-size: 26px 26px;
    mask-image: radial-gradient(ellipse 70% 80% at 15% 30%, #000, transparent 70%);
  }

  .hero__grille {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--espace-7);
    min-height: 600px;
    padding-block: 72px;
  }

  .hero__texte {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .hero h1 {
    font-size: var(--taille-h1);
    line-height: 1.06;
  }

  .hero__accroche {
    font-size: var(--taille-accroche);
    font-weight: var(--graisse-demi);
    line-height: 1.3;
  }

  .fond-fonce .hero__accroche {
    color: var(--vert-accent);
  }

  .hero__introduction {
    max-width: 520px;
    font-size: var(--taille-texte-grand);
  }

  .hero__boutons {
    margin-top: var(--espace-2);
  }

  .hero__visuel {
    position: relative;
    height: 440px;
  }

  /* Cadre décalé derrière la photo */
  .hero__cadre {
    position: absolute;
    inset: 18px -18px -18px 18px;
    z-index: -1;
    border: 2px solid var(--sur-fonce-bordure);
    border-radius: var(--rayon-carte);
  }

  /* ---------- Entrée du hero au chargement ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .hero__decor::before {
      animation: hero-derive 14s ease-in-out 2 alternate;
    }

    .hero__texte > *,
    .hero h1 span {
      animation: hero-entree 900ms var(--courbe-sortie) both;
    }

    .hero h1 span {
      display: inline-block;
    }

    .hero__texte > :nth-child(1) {
      animation-delay: 80ms;
    }

    /* Le titre lui-même ne bouge pas : ses trois verbes arrivent l'un après l'autre */
    .hero__texte > h1 {
      animation: none;
    }

    .hero h1 span:nth-child(1) {
      animation-delay: 160ms;
    }

    .hero h1 span:nth-child(2) {
      animation-delay: 260ms;
    }

    .hero h1 span:nth-child(3) {
      animation-delay: 360ms;
    }

    .hero__texte > :nth-child(3) {
      animation-delay: 480ms;
    }

    .hero__texte > :nth-child(4) {
      animation-delay: 560ms;
    }

    .hero__texte > :nth-child(5) {
      animation-delay: 640ms;
    }

    /* Photo : affichée immédiatement (image principale de la page), simple léger zoom arrière */
    .hero__visuel :global(.photo) {
      animation: hero-photo 1600ms var(--courbe-sortie) both;
    }

    .hero__cadre {
      animation: hero-cadre 1200ms var(--courbe-sortie) 400ms both;
    }
  }

  @keyframes hero-entree {
    from {
      opacity: 0;
      translate: 0 24px;
    }
  }

  @keyframes hero-photo {
    from {
      scale: 1.06;
    }
  }

  @keyframes hero-cadre {
    from {
      opacity: 0;
      translate: -18px -18px;
    }
  }

  @keyframes hero-derive {
    to {
      translate: -18% 22%;
      scale: 1.15;
    }
  }

  /* ---------- Pourquoi ---------- */
  .pourquoi {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: var(--espace-6);
    align-items: stretch;
  }

  .pourquoi__visuel {
    min-height: 460px;
  }

  .pourquoi__arguments {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px var(--espace-5);
    align-content: center;
  }

  /* ---------- En-tête de section avec lien à droite ---------- */
  .entete-ligne {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--espace-3);
  }

  /* ---------- Tablette ---------- */
  @media (max-width: 999px) {
    .hero__grille {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--espace-6);
      min-height: 0;
      padding-block: var(--espace-6);
    }

    .hero__visuel {
      height: clamp(236px, 50vw, 420px);
    }

    .pourquoi {
      grid-template-columns: minmax(0, 1fr);
    }

    .pourquoi__visuel {
      min-height: 0;
      height: clamp(200px, 45vw, 400px);
    }
  }

  /* ---------- Mobile ---------- */
  @media (max-width: 640px) {
    .hero__grille {
      padding-block: 40px;
      gap: var(--espace-5);
    }

    .hero__texte {
      gap: var(--espace-3);
    }

    /* Un verbe par ligne, comme sur la maquette mobile */
    .hero h1 span {
      display: block;
    }

    .hero__introduction {
      font-size: var(--taille-texte);
    }

    .hero__cadre {
      inset: 12px -10px -12px 10px;
    }

    .pourquoi__arguments {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
  }
</style>
