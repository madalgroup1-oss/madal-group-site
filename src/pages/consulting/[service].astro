---
import PageService from '../../components/PageService.astro';
import { SERVICES_CONSULTING, type ServiceDetaille } from '../../data/landings';

export function getStaticPaths() {
  return SERVICES_CONSULTING.map((service) => ({ params: { service: service.slug }, props: { service } }));
}

interface Props {
  service: ServiceDetaille;
}

const { service } = Astro.props;
---

<PageService service={service} services={SERVICES_CONSULTING} pole="consulting" />
