---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import EntetePage from '../components/EntetePage.astro';
import FormulaireDemande from '../components/FormulaireDemande.astro';
import Icone from '../components/Icone.astro';
import accueilReception from '../assets/images/accueil-reception.jpg';
import {
  ADRESSE,
  CARTE_INTEGREE,
  EMAIL,
  ITINERAIRE,
  PAYS,
  TELEPHONES,
  lienWhatsApp,
} from '../lib/coordonnees';
import { etablissement, jsonLd } from '../lib/seo';

// Texte officiel : docs/brief-strategique.md, section 13 « Page Contact »

const photoAccueil = await getImage({ src: accueilReception, width: 1200, format: 'jpg' });
const donneesEtablissement = etablissement(new URL(photoAccueil.src, Astro.site).href);
---

<Base
  titre="Contact — MADAL GROUP, Yopougon Camp Militaire, Abidjan"
  description="Contactez MADAL GROUP à Abidjan : Yopougon Camp Militaire, 07 87 45 76 18, 05 44 82 05 83, madalgroup1@gmail.com. WhatsApp, appel, email ou formulaire."
  page="Contact"
  blocCTA={false}
>
  <script type="application/ld+json" slot="head" set:html={jsonLd(donneesEtablissement)} />

  <EntetePage
    etiquette="Contact"
    titre="Parlons de votre projet"
    visuel={{ src: accueilReception, alt: "La banque d'accueil du siège de MADAL GROUP" }}
  />

  <!-- Boutons directs et coordonnées -->
  <section class="section" aria-labelledby="coordonnees-titre">
    <div class="conteneur contact">
      <div class="contact__infos" data-apparition>
        <div class="entete-section">
          <p class="etiquette">Nous joindre</p>
          <h2 id="coordonnees-titre">MADAL GROUP SARL</h2>
        </div>

        <ul class="actions" aria-label="Contact direct">
          <li>
            <a class="action" href={lienWhatsApp('Contact')} target="_blank" rel="noopener">
              <Icone nom="whatsapp" taille={26} />
              <span class="action__libelle">WhatsApp</span>
              <span class="visuellement-cache"> (nouvelle fenêtre)</span>
            </a>
          </li>
          <li>
            <a class="action" href={TELEPHONES[0].lien}>
              <Icone nom="telephone" taille={26} />
              <span class="action__libelle">Appeler</span>
            </a>
          </li>
          <li>
            <a class="action" href={`mailto:${EMAIL}`}>
              <Icone nom="email" taille={26} />
              <span class="action__libelle">Email</span>
            </a>
          </li>
          <li>
            <a class="action" href={ITINERAIRE} target="_blank" rel="noopener">
              <Icone nom="itineraire" taille={26} />
              <span class="action__libelle">Itinéraire</span>
              <span class="visuellement-cache"> (Google Maps, nouvelle fenêtre)</span>
            </a>
          </li>
        </ul>

        <dl class="fiche">
          <div class="fiche__ligne">
            <dt class="etiquette">Adresse</dt>
            <dd>{ADRESSE}, {PAYS}</dd>
          </div>
          <div class="fiche__ligne">
            <dt class="etiquette">Téléphones</dt>
            <dd>
              {
                TELEPHONES.map((telephone) => (
                  <a href={telephone.lien}>{telephone.affiche}</a>
                ))
              }
            </dd>
          </div>
          <div class="fiche__ligne">
            <dt class="etiquette">Email</dt>
            <dd><a href={`mailto:${EMAIL}`}>{EMAIL}</a></dd>
          </div>
        </dl>
      </div>

      <!-- Carte Google Maps chargée seulement au clic (vitesse et vie privée) -->
      <div class="carte-plan angle-coupe" data-carte={CARTE_INTEGREE} data-apparition="image">
        <div class="trame trame--fonce carte-plan__trame" aria-hidden="true"></div>
        <div class="carte-plan__invite">
          <Icone nom="lieu" taille={36} epaisseur={1.6} />
          <p>{ADRESSE}</p>
          <button class="bouton bouton--compact" type="button" data-carte-afficher>Afficher la carte</button>
          <p class="carte-plan__mention">La carte est fournie par Google Maps.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Formulaire de contact (F1) -->
  <section class="section section--grise" id="demande" aria-labelledby="formulaire-titre">
    <div class="conteneur contact-formulaire">
      <div class="entete-section" data-apparition>
        <p class="etiquette">Formulaire</p>
        <h2 id="formulaire-titre">Écrivez-nous</h2>
      </div>
      <FormulaireDemande page="Contact" />
    </div>
  </section>
</Base>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: stretch;
    gap: var(--espace-6);
  }

  @media (max-width: 899px) {
    .contact {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--espace-5);
    }
  }

  .contact__infos {
    display: flex;
    flex-direction: column;
    gap: var(--espace-5);
  }

  /* ---------- Quatre boutons directs ---------- */
  .actions {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--espace-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 640px) {
    .actions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .action {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--espace-1);
    min-height: 96px;
    padding: var(--espace-3) var(--espace-1);
    border: 1px solid var(--bordure-champ);
    border-radius: var(--rayon-carte);
    background: var(--blanc);
    color: var(--vert-fonce);
    text-decoration: none;
    transition:
      background-color var(--transition),
      border-color var(--transition),
      box-shadow var(--duree-survol) var(--courbe-sortie);
  }

  .action :global(svg) {
    color: var(--vert-texte);
  }

  .action:hover {
    border-color: var(--vert-fonce);
    background: var(--vert-pale);
    color: var(--vert-fonce);
    box-shadow: var(--ombre-carte-survol);
  }

  .action__libelle {
    font-family: var(--police-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* ---------- Fiche de coordonnées ---------- */
  .fiche {
    display: flex;
    flex-direction: column;
    margin: 0;
    border-top: 1px solid var(--bordure);
  }

  .fiche__ligne {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: var(--espace-2);
    padding-block: var(--espace-3);
    border-bottom: 1px solid var(--bordure);
  }

  @media (max-width: 480px) {
    .fiche__ligne {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
  }

  .fiche dt {
    padding-top: 3px;
  }

  .fiche dd {
    display: flex;
    flex-wrap: wrap;
    gap: 4px var(--espace-3);
    margin: 0;
    font-size: var(--taille-texte-grand);
    font-weight: var(--graisse-demi);
    color: var(--vert-fonce);
    overflow-wrap: anywhere;
  }

  .fiche a {
    display: inline-flex;
    align-items: center;
    min-height: var(--cible-tactile);
    margin-block: -10px;
    color: var(--vert-fonce);
  }

  .fiche a:hover {
    color: var(--vert-texte);
  }

  /* ---------- Carte ---------- */
  .carte-plan {
    position: relative;
    isolation: isolate;
    min-height: 360px;
    overflow: hidden;
    background: var(--vert-fonce);
  }

  .carte-plan__trame {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .carte-plan__invite {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--espace-2);
    height: 100%;
    min-height: 360px;
    padding: var(--espace-5);
    color: var(--vert-accent);
    text-align: center;
  }

  .carte-plan__invite p {
    font-size: var(--taille-texte-grand);
    font-weight: var(--graisse-demi);
    color: var(--blanc);
  }

  .carte-plan__invite .carte-plan__mention {
    font-size: 0.875rem;
    font-weight: var(--graisse-normal);
    color: var(--sur-fonce-texte);
  }

  .carte-plan :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* ---------- Formulaire ---------- */
  .contact-formulaire {
    display: flex;
    flex-direction: column;
    gap: var(--espace-5);
    max-width: 860px;
  }
</style>

<script>
  import '../scripts/carte';
</script>
