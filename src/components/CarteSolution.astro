---
import { Image } from 'astro:assets';
import { urlMedia, type Solution } from '../lib/supabase';
import { NOM_POLE, TYPE_SOLUTION } from '../lib/libelles';
import { VISUELS_SOLUTIONS_PROVISOIRES } from '../data/visuels';

interface Props {
  solution: Solution;
}

const { solution } = Astro.props;
// Logo téléversé dans /admin, sinon visuel local provisoire, sinon contenu à fournir
const visuelLocal = VISUELS_SOLUTIONS_PROVISOIRES[solution.slug];
const altVisuel = `Logo ${solution.nom}`;
---

<article class="carte-solution">
  <div
    class:list={[
      'carte-solution__visuel',
      { 'carte-solution__visuel--vide': !solution.logo_path && !visuelLocal },
    ]}
  >
    {
      solution.logo_path ? (
        <Image
          src={urlMedia(solution.logo_path)}
          alt={altVisuel}
          inferSize
          widths={[320, 480, 800]}
          sizes="(min-width: 900px) 400px, 86vw"
        />
      ) : visuelLocal ? (
        <Image
          src={visuelLocal.src}
          alt={visuelLocal.alt}
          widths={[320, 480, 800]}
          sizes="(min-width: 900px) 400px, 86vw"
        />
      ) : (
        <span>[À FOURNIR : capture d'écran {solution.nom}]</span>
      )
    }
  </div>
  <div class="carte-solution__corps">
    <p class="carte-solution__pole">
      {NOM_POLE[solution.pole]}{' · '}{TYPE_SOLUTION[solution.type]}
    </p>
    <h3 class="carte-solution__nom">{solution.nom}</h3>
    <p class="carte-solution__texte">{solution.resume}</p>
    <a class="lien-fleche carte-solution__lien" href={`/solutions/${solution.slug}`}>
      Voir la fiche<span class="visuellement-cache"> {solution.nom}</span>
    </a>
  </div>
</article>

<style>
  .carte-solution {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: var(--blanc);
    border-radius: var(--rayon-carte);
    transition: box-shadow var(--transition);
  }

  .carte-solution:hover {
    box-shadow: var(--ombre-carte);
  }

  .carte-solution__lien::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .carte-solution__visuel {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 240px;
    padding: 0 var(--espace-4);
    background: var(--blanc);
    border-bottom: 1px solid var(--bordure);
  }

  .carte-solution__visuel img {
    width: 400px;
    max-width: 86%;
    height: auto;
    max-height: 200px;
    object-fit: contain;
  }

  .carte-solution__visuel--vide {
    background: var(--gris-image);
    border-bottom: 0;
    font-size: var(--taille-texte-petit);
    font-weight: var(--graisse-demi);
    color: var(--texte-secondaire);
    text-align: center;
  }

  .carte-solution__corps {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 10px;
    padding: 28px;
  }

  .carte-solution__pole {
    font-size: 0.8125rem;
    font-weight: var(--graisse-demi);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--vert-texte);
  }

  .carte-solution__nom {
    font-size: 1.5rem;
  }

  .carte-solution__texte {
    color: var(--texte-secondaire);
  }

  .carte-solution__lien {
    margin-top: auto;
  }

  @media (max-width: 640px) {
    .carte-solution__visuel {
      height: 180px;
    }

    .carte-solution__corps {
      padding: var(--espace-4);
    }
  }
</style>
