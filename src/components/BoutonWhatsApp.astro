---
import { lienWhatsApp } from '../lib/coordonnees';

interface Props {
  /** Nom lisible de la page d'origine, repris dans le message pré-rempli. */
  page: string;
}

const { page } = Astro.props;
---

<a
  class="whatsapp"
  href={lienWhatsApp(page)}
  target="_blank"
  rel="noopener"
  aria-label="Écrire à MADAL GROUP sur WhatsApp (nouvelle fenêtre)"
  data-inerte-menu
>
  <svg
    width="28"
    height="28"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"></path>
  </svg>
</a>

<style>
  .whatsapp {
    position: fixed;
    right: max(16px, env(safe-area-inset-right));
    bottom: max(16px, env(safe-area-inset-bottom));
    z-index: 90;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--vert-accent);
    color: var(--vert-fonce);
    box-shadow: var(--ombre-flottant);
    transition: transform var(--transition);
  }

  .whatsapp:hover {
    color: var(--vert-fonce);
    transform: scale(1.06);
  }

  .whatsapp:focus-visible {
    outline: 3px solid var(--vert-fonce);
    outline-offset: 3px;
    border-radius: 50%;
  }

  @media (min-width: 900px) {
    .whatsapp {
      right: 24px;
      bottom: 24px;
      width: 60px;
      height: 60px;
    }
  }
</style>
